#!/bin/bash
# Mac bootstrap. Read this file before running it. No sudo, Git or Homebrew.
set -euo pipefail
# Parse the entire bootstrap before executing, so an interrupted download cannot
# run a truncated top-level install.
# >>> caravan strings (generated from locales/en.json; edit there, then run: python3 tools/caravan_i18n.py --sync-shell) >>>
S_usage_install_role_lead_worker_check() { printf '%s' "Usage: install [--role lead|worker] [--check] [--update] [--no-start] [--port PORT] [--name NAME]"; }
S_arg_needs_a_value() { printf '%s' "${1} needs a value"; }
S_unknown_option_arg_use_help() { printf '%s' "Unknown option: ${1}. Use --help."; }
S_service_name_must_use_letters_numbers() { printf '%s' "Service name must use letters, numbers, _ or -."; }
S_service_name_is_too_long() { printf '%s' "Service name is too long."; }
S_choose_lead_or_worker() { printf '%s' "Choose lead or worker."; }
S_port_must_be_1_65535() { printf '%s' "Port must be 1–65535."; }
S_caravan_needs_a_mac_with_apple() { printf '%s' "Caravan needs a Mac with Apple Silicon. Nothing was installed."; }
S_use_apple_silicon_and_a_terminal() { printf '%s' "Use Apple Silicon and a Terminal not running with Rosetta. Intel Macs are not supported."; }
S_run_as_your_normal_mac_user() { printf '%s' "Run as your normal Mac user, without sudo."; }
S_update_macos_to_14_or_newer() { printf '%s' "Update macOS to 14 or newer (found ${1})."; }
S_your_home_folder_is_not_writable() { printf '%s' "Your home folder is not writable. Check its permissions."; }
S_free_at_least_8_gb_on() { printf '%s' "Free at least 8 GB on this Mac, then retry. Models need additional space."; }
S_this_mac_has_too_little_memory() { printf '%s' "This Mac has too little memory for setup. More memory or additional Macs lets you run bigger models."; }
S_caravan_checks_which_models_fit_more() { printf '%s' "Caravan checks which models fit. More memory, or adding Macs, lets you run bigger models."; }
S_mac_checks_passed_macos_os_apple() { printf '%s' "Mac checks passed: macOS ${1}, Apple Silicon. No administrator password needed."; }
S_filevault_unlock_and_log_into_this() { printf '%s' "FileVault: unlock and log into this Mac after reboot; services run at login, not at the unlock screen."; }
S_check_only_nothing_changed_setup_downloads() { printf '%s' "Check only: nothing changed. Setup downloads its own Python; Git, Homebrew and Xcode are not required."; }
S_port_port_is_busy_if_not() { printf '%s' "Port ${1} is busy. If not Caravan, close that app or choose --port NUMBER."; }
S_an_existing_custom_web_service_is() { printf '%s' "An existing custom web service is installed. Keep it; follow the source-install update instructions in INSTALL.md. Nothing was changed."; }
S_setup_stopped_existing_models_settings_were() { printf '%s' "Setup stopped. Existing models/settings were kept. Check your internet connection and the error above, then retry."; }
S_another_setup_is_running_if_none() { printf '%s' "Another setup is running. If none is running, remove ${1}/install.lock and retry."; }
S_setup_stopped_models_settings_kept_inspect() { printf '%s' "Setup stopped. Models/settings kept; inspect the error above and retry."; }
S_could_not_download_arg_check_wi() { printf '%s' "Could not download ${1}. Check Wi-Fi, proxy/firewall and free space, then retry."; }
S_invalid_package_manifest_nothing_activated() { printf '%s' "Invalid package manifest; nothing activated."; }
S_invalid_package_checksum_nothing_activated() { printf '%s' "Invalid package checksum; nothing activated."; }
S_caravan_is_already_up_to_date() { printf '%s' "Caravan is already up to date."; }
S_an_existing_source_install_lives_here() { printf '%s' "An existing source install lives here. Keep it; see INSTALL.md for migration. Nothing was replaced."; }
S_caravan_is_already_installed_run_caravan() { printf '%s' "Caravan is already installed. Run ~/.caravan/bin/caravan update to change versions."; }
S_package_integrity_list_missing_existing_code() { printf '%s' "Package integrity list missing; existing code kept."; }
S_installed_source_has_edits_keep_them() { printf '%s' "Installed source has edits. Keep them; use a separate source checkout. No files replaced."; }
S_source_checksum_mismatch_nothing_activated_r() { printf '%s' "Source checksum mismatch. Nothing activated; retry later."; }
S_package_is_missing_its_installer() { printf '%s' "Package is missing its installer."; }
S_package_is_missing_its_updater_existing() { printf '%s' "Package is missing its updater. Existing code kept."; }
S_caravan_python_is_missing_existing_source() { printf '%s' "Caravan Python is missing; existing source kept. Run the install command again or caravan doctor."; }
S_previous_source_saved_at_backup_models() { printf '%s' "Previous source saved at ${1} (models/settings unchanged)."; }
S_python_installer_checksum_mismatch_nothing_e() { printf '%s' "Python installer checksum mismatch. Nothing executed."; }
S_preparing_private_python_3_12_nothing() { printf '%s' "Preparing private Python 3.12. Nothing changes the Mac system Python."; }
S_open_a_new_terminal_window_to() { printf '%s' "Open a new Terminal window to use caravan. Next time: caravan status (or doctor, start, stop, update, uninstall, add-mini)."; }
S_the_web_page_is_not_ready() { printf '%s' "The web page is not ready yet. Run ~/.caravan/bin/caravan doctor and check ~/.caravan/logs/web.log."; }
# <<< caravan strings <<<
main() {
say() { printf '[Caravan] %s\n' "$*"; }
fail() { say "$*" >&2; exit 1; }
REPLACE=0; ROLE=lead; CHECK=0; UPDATE=0; START=1; PORT=8190; NAME=web
while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h) say "$(S_usage_install_role_lead_worker_check)"; exit 0 ;;
    --check) CHECK=1; shift ;;
    --update) UPDATE=1; shift ;;
    --replace-old-services) REPLACE=1; shift ;;
    --no-start) START=0; shift ;;
    --role|--port|--name) [ "$#" -ge 2 ] || fail "$(S_arg_needs_a_value "$1")"; case "$1" in --role) ROLE=$2 ;; --port) PORT=$2 ;; --name) NAME=$2 ;; esac; shift 2 ;;
    *) fail "$(S_unknown_option_arg_use_help "$1")" ;;
  esac
done
case "$NAME" in ''|*[!A-Za-z0-9_-]*) fail "$(S_service_name_must_use_letters_numbers)" ;; esac
[ "${#NAME}" -le 64 ] || fail "$(S_service_name_is_too_long)"
[ "$ROLE" = lead ] || [ "$ROLE" = worker ] || fail "$(S_choose_lead_or_worker)"
case "$PORT" in ''|*[!0-9]*|??????*) fail "$(S_port_must_be_1_65535)" ;; esac
[ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || fail "$(S_port_must_be_1_65535)"
[ "$(uname -s)" = Darwin ] || fail "$(S_caravan_needs_a_mac_with_apple)"
[ "$(uname -m)" = arm64 ] || fail "$(S_use_apple_silicon_and_a_terminal)"
[ "$(id -u)" != 0 ] || fail "$(S_run_as_your_normal_mac_user)"
OS=$(sw_vers -productVersion); [ "${OS%%.*}" -ge 14 ] || fail "$(S_update_macos_to_14_or_newer "$OS")"
[ -d "$HOME" ] && [ -w "$HOME" ] || fail "$(S_your_home_folder_is_not_writable)"
FREE=$(df -Pk "$HOME" | awk 'END {print $4}')
[ "$FREE" -ge 8388608 ] || fail "$(S_free_at_least_8_gb_on)"
RAM=$(sysctl -n hw.memsize)
[ "$RAM" -ge 8589934592 ] || fail "$(S_this_mac_has_too_little_memory)"
say "$(S_caravan_checks_which_models_fit_more)"
say "$(S_mac_checks_passed_macos_os_apple "$OS")"
say "$(S_filevault_unlock_and_log_into_this)"
if [ "$CHECK" = 1 ]; then
  say "$(S_check_only_nothing_changed_setup_downloads)"
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then say "$(S_port_port_is_busy_if_not "$PORT")"; fi
  exit 0
fi
ROOT="$HOME/.caravan"; REPO="$ROOT/src/caravan"; TMP=""
if [ "$ROLE" = lead ] && [ -e "$ROOT/services/$NAME.json" ] && [ ! -f "$REPO/.caravan-package" ]; then
  fail "$(S_an_existing_custom_web_service_is)"
fi
trap 'code=$?; [ -z "$TMP" ] || rm -rf "$TMP"; if [ "$code" != 0 ]; then say "$(S_setup_stopped_existing_models_settings_were)" >&2; fi' EXIT
mkdir -p "$ROOT"
# One installer at a time. A stale lock is reported rather than silently removed.
mkdir "$ROOT/install.lock" 2>/dev/null || fail "$(S_another_setup_is_running_if_none "$ROOT")"
trap 'code=$?; rmdir "$ROOT/install.lock"; [ -z "$TMP" ] || rm -rf "$TMP"; if [ "$code" != 0 ]; then say "$(S_setup_stopped_models_settings_kept_inspect)" >&2; fi' EXIT
TMP=$(mktemp -d "$ROOT/setup.XXXXXX")
fetch() { curl --proto '=https' --tlsv1.2 -fLsS --retry 2 --connect-timeout 15 --max-time 300 "$1" -o "$2" || fail "$(S_could_not_download_arg_check_wi "$1")"; }
# The moving channel only selects a SHA-pinned source archive and checksum.
fetch "https://raw.githubusercontent.com/linuxbren/caravan/main/packaging-version?channel=$(date +%s)" "$TMP/version"
read -r REF SHA < "$TMP/version"
[ "${#REF}" = 40 ] && [ "${#SHA}" = 64 ] || fail "$(S_invalid_package_manifest_nothing_activated)"
case "$REF$SHA" in *[!a-f0-9]*) fail "$(S_invalid_package_checksum_nothing_activated)" ;; esac
if [ "$UPDATE" = 1 ] && [ -f "$REPO/.caravan-package" ] && [ "$(< "$REPO/.caravan-package")" = "$REF" ]; then
  printf '%s\n' "$(S_caravan_is_already_up_to_date)"
  exit 0
fi
if [ -e "$REPO" ]; then
  [ -f "$REPO/.caravan-package" ] && [ ! -d "$REPO/.git" ] || fail "$(S_an_existing_source_install_lives_here)"
  if [ "$(< "$REPO/.caravan-package")" != "$REF" ]; then
    [ "$UPDATE" = 1 ] || fail "$(S_caravan_is_already_installed_run_caravan)"
    [ -f "$REPO/.caravan-package-files" ] || fail "$(S_package_integrity_list_missing_existing_code)"
    (cd "$REPO" && shasum -a 256 -c .caravan-package-files >/dev/null) || fail "$(S_installed_source_has_edits_keep_them)"
  fi
fi
if [ ! -f "$REPO/.caravan-package" ] || [ "$(< "$REPO/.caravan-package")" != "$REF" ]; then
  fetch "https://codeload.github.com/linuxbren/caravan/tar.gz/$REF" "$TMP/source.tar.gz"
  ACTUAL=$(shasum -a 256 "$TMP/source.tar.gz" | awk '{print $1}')
  [ "$ACTUAL" = "$SHA" ] || fail "$(S_source_checksum_mismatch_nothing_activated_r)"
  mkdir "$TMP/source"
  tar -xzf "$TMP/source.tar.gz" -C "$TMP/source" --strip-components=1
  [ -f "$TMP/source/scripts/install.sh" ] || fail "$(S_package_is_missing_its_installer)"
  printf '%s\n' "$REF" > "$TMP/source/.caravan-package"
  # The source archive carries the previous pin's packaging-version.
  # Write the channel manifest (the SHA that selected this archive, plus
  # its checksum) so an update records the version that was just applied.
  printf '%s %s\n' "$REF" "$SHA" > "$TMP/source/packaging-version"
  (cd "$TMP/source" && /usr/bin/find . -type f ! -name '.caravan-package-files' ! -path '*/__pycache__/*' -exec shasum -a 256 {} \; > .caravan-package-files)
  if [ "$UPDATE" = 1 ]; then
    [ -f "$TMP/source/tools/caravan_update.py" ] || fail "$(S_package_is_missing_its_updater_existing)"
    VPY="$ROOT/venvs/mlx/bin/python"
    [ -x "$VPY" ] || fail "$(S_caravan_python_is_missing_existing_source)"
    APPLY=("$VPY" "$TMP/source/tools/caravan_update.py" apply --home "$HOME" --repo "$REPO" --new "$TMP/source" --name "$NAME" --port "$PORT" --role "$ROLE" --python "$VPY")
    [ "$START" = 1 ] || APPLY+=(--no-start)
    "${APPLY[@]}"
    code=$?
    trap 'rmdir "$ROOT/install.lock"; [ -z "$TMP" ] || rm -rf "$TMP"' EXIT
    exit "$code"
  fi
  mkdir -p "$ROOT/src"
  if [ -e "$REPO" ]; then
    BACKUP="$ROOT/src/caravan-backup-$(date +%s)"
    mv "$REPO" "$BACKUP"; say "$(S_previous_source_saved_at_backup_models "$BACKUP")"
  fi
  mv "$TMP/source" "$REPO"
fi
# Dedicated pinned uv binary, with its publisher's release checksum.
UV="$ROOT/runtime/uv/uv"
if [ ! -x "$UV" ]; then
  fetch https://github.com/astral-sh/uv/releases/download/0.8.22/uv-aarch64-apple-darwin.tar.gz "$TMP/uv.tar.gz"
  [ "$(shasum -a 256 "$TMP/uv.tar.gz" | awk '{print $1}')" = 3f61099e261e449527141dbf125629fab33ad696468c8c90cebbac40185a306c ] || fail "$(S_python_installer_checksum_mismatch_nothing_e)"
  mkdir -p "$ROOT/runtime/uv"
  tar -xzf "$TMP/uv.tar.gz" -C "$ROOT/runtime/uv" --strip-components=1
fi
export UV_PYTHON_INSTALL_DIR="$ROOT/runtime/python" UV_PYTHON_BIN_DIR="$ROOT/runtime/bin" UV_CACHE_DIR="$ROOT/runtime/cache"
say "$(S_preparing_private_python_3_12_nothing)"
"$UV" python install 3.12.11
PYTHON=$("$UV" python find --managed-python 3.12.11)
HAS_PAIRING=0
[ ! -f "$REPO/tools/caravan_pairing.py" ] || HAS_PAIRING=1
ARGS=(--role "$ROLE" --repo "$REPO" --use-existing --python "$PYTHON")
if [ "$ROLE" = lead ] || [ "$HAS_PAIRING" = 1 ]; then ARGS+=(--port "$PORT" --name "$NAME"); fi
[ "$START" = 1 ] || ARGS+=(--no-start)
[ "$REPLACE" = 0 ] || ARGS+=(--replace-old-services)
bash "$REPO/scripts/install.sh" "${ARGS[@]}"
say "$(S_open_a_new_terminal_window_to)"
if [ "$START" = 1 ] && { [ "$ROLE" = lead ] || [ "$HAS_PAIRING" = 1 ]; }; then
  READY=0
  for attempt in {1..30}; do
    if curl -fsS --max-time 2 "http://127.0.0.1:$PORT/" >/dev/null; then READY=1; break; fi
    sleep 1
  done
  if [ "$READY" = 1 ]; then
    if [ "$HAS_PAIRING" = 1 ]; then
      HANDOFF=$("$HOME/.caravan/venvs/mlx/bin/python" "$REPO/tools/caravan_pairing.py" launch-file --port "$PORT" --home-page)
      open "$HANDOFF"
    else
      # Keep the bootstrap compatible while a reviewed source pin is published.
      open "http://127.0.0.1:$PORT/"
    fi
  else say "$(S_the_web_page_is_not_ready)"; exit 1; fi
fi

}
main "$@"
