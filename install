#!/bin/bash
# Mac bootstrap. Read this file before running it. No sudo, Git or Homebrew.
set -euo pipefail
# Parse the entire bootstrap before executing, so an interrupted download cannot
# run a truncated top-level install.
main() {
say() { printf '[Caravan] %s\n' "$*"; }
fail() { say "$*" >&2; exit 1; }
ROLE=lead; CHECK=0; UPDATE=0; START=1; PORT=8190; NAME=web
while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h) say 'Usage: install [--role lead|worker] [--check] [--update] [--no-start] [--port PORT] [--name NAME]'; exit 0 ;;
    --check) CHECK=1; shift ;;
    --update) UPDATE=1; shift ;;
    --no-start) START=0; shift ;;
    --role|--port|--name) [ "$#" -ge 2 ] || fail "$1 needs a value"; case "$1" in --role) ROLE=$2 ;; --port) PORT=$2 ;; --name) NAME=$2 ;; esac; shift 2 ;;
    *) fail "Unknown option: $1. Use --help." ;;
  esac
done
case "$NAME" in ''|*[!A-Za-z0-9_-]*) fail 'Service name must use letters, numbers, _ or -.' ;; esac
[ "${#NAME}" -le 64 ] || fail 'Service name is too long.'
[ "$ROLE" = lead ] || [ "$ROLE" = worker ] || fail 'Choose lead or worker.'
case "$PORT" in ''|*[!0-9]*|??????*) fail 'Port must be 1–65535.' ;; esac
[ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || fail 'Port must be 1–65535.'
[ "$(uname -s)" = Darwin ] || fail 'Caravan needs a Mac with Apple Silicon. Nothing was installed.'
[ "$(uname -m)" = arm64 ] || fail 'Use Apple Silicon and a Terminal not running with Rosetta. Intel Macs are not supported.'
[ "$(id -u)" != 0 ] || fail 'Run as your normal Mac user, without sudo.'
OS=$(sw_vers -productVersion); [ "${OS%%.*}" -ge 14 ] || fail "Update macOS to 14 or newer (found $OS)."
[ -d "$HOME" ] && [ -w "$HOME" ] || fail 'Your home folder is not writable. Check its permissions.'
FREE=$(df -Pk "$HOME" | awk 'END {print $4}')
[ "$FREE" -ge 8388608 ] || fail 'Free at least 8 GB on this Mac, then retry. Models need additional space.'
RAM=$(sysctl -n hw.memsize)
[ "$RAM" -ge 8589934592 ] || fail 'This Mac has too little memory for setup. More memory or additional Macs lets you run bigger models.'
say 'Caravan checks which models fit. More memory, or adding Macs, lets you run bigger models.'
say "Mac checks passed: macOS $OS, Apple Silicon. No administrator password needed."
say 'FileVault: unlock and log into this Mac after reboot; services run at login, not at the unlock screen.'
if [ "$CHECK" = 1 ]; then
  say 'Check only: nothing changed. Setup downloads its own Python; Git, Homebrew and Xcode are not required.'
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then say "Port $PORT is busy. If not Caravan, close that app or choose --port NUMBER."; fi
  exit 0
fi
ROOT="$HOME/.caravan"; REPO="$ROOT/src/caravan"; TMP=""
if [ "$ROLE" = lead ] && [ -e "$ROOT/services/$NAME.json" ] && [ ! -f "$REPO/.caravan-package" ]; then
  fail 'An existing custom web service is installed. Keep it; follow the source-install update instructions in INSTALL.md. Nothing was changed.'
fi
trap 'code=$?; [ -z "$TMP" ] || rm -rf "$TMP"; if [ "$code" != 0 ]; then say "Setup stopped. Existing models/settings were kept. Check your internet connection and the error above, then retry." >&2; fi' EXIT
mkdir -p "$ROOT"
# One installer at a time. A stale lock is reported rather than silently removed.
mkdir "$ROOT/install.lock" 2>/dev/null || fail "Another setup is running. If none is running, remove $ROOT/install.lock and retry."
trap 'code=$?; rmdir "$ROOT/install.lock"; [ -z "$TMP" ] || rm -rf "$TMP"; if [ "$code" != 0 ]; then say "Setup stopped. Models/settings kept; inspect the error above and retry." >&2; fi' EXIT
TMP=$(mktemp -d "$ROOT/setup.XXXXXX")
fetch() { curl --proto '=https' --tlsv1.2 -fLsS --retry 2 --connect-timeout 15 --max-time 300 "$1" -o "$2" || fail "Could not download $1. Check Wi-Fi, proxy/firewall and free space, then retry."; }
# The moving channel only selects a SHA-pinned source archive and checksum.
fetch "https://raw.githubusercontent.com/linuxbren/caravan/caravan-v3-mlx-split/packaging-version?channel=$(date +%s)" "$TMP/version"
read -r REF SHA < "$TMP/version"
[ "${#REF}" = 40 ] && [ "${#SHA}" = 64 ] || fail 'Invalid package manifest; nothing activated.'
case "$REF$SHA" in *[!a-f0-9]*) fail 'Invalid package checksum; nothing activated.' ;; esac
if [ -e "$REPO" ]; then
  [ -f "$REPO/.caravan-package" ] && [ ! -d "$REPO/.git" ] || fail 'An existing source install lives here. Keep it; see INSTALL.md for migration. Nothing was replaced.'
  if [ "$(< "$REPO/.caravan-package")" != "$REF" ]; then
    [ "$UPDATE" = 1 ] || fail 'Caravan is already installed. Run ~/.caravan/bin/caravan update to change versions.'
    [ -f "$REPO/.caravan-package-files" ] || fail 'Package integrity list missing; existing code kept.'
    (cd "$REPO" && shasum -a 256 -c .caravan-package-files >/dev/null) || fail 'Installed source has edits. Keep them; use a separate source checkout. No files replaced.'
    if launchctl print "gui/$(id -u)/com.caravan.v3.$NAME" >/dev/null 2>&1; then fail 'Stop the web first with caravan stop, then run caravan update. Models are left running.'; fi
  fi
fi
if [ ! -f "$REPO/.caravan-package" ] || [ "$(< "$REPO/.caravan-package")" != "$REF" ]; then
  fetch "https://codeload.github.com/linuxbren/caravan/tar.gz/$REF" "$TMP/source.tar.gz"
  ACTUAL=$(shasum -a 256 "$TMP/source.tar.gz" | awk '{print $1}')
  [ "$ACTUAL" = "$SHA" ] || fail 'Source checksum mismatch. Nothing activated; retry later.'
  mkdir "$TMP/source"
  tar -xzf "$TMP/source.tar.gz" -C "$TMP/source" --strip-components=1
  [ -f "$TMP/source/scripts/install.sh" ] || fail 'Package is missing its installer.'
  printf '%s\n' "$REF" > "$TMP/source/.caravan-package"
  (cd "$TMP/source" && /usr/bin/find . -type f ! -name '.caravan-package-files' ! -path '*/__pycache__/*' -exec shasum -a 256 {} \; > .caravan-package-files)
  mkdir -p "$ROOT/src"
  if [ -e "$REPO" ]; then
    BACKUP="$ROOT/src/caravan-backup-$(date +%s)"
    mv "$REPO" "$BACKUP"; say "Previous source saved at $BACKUP (models/settings unchanged)."
  fi
  mv "$TMP/source" "$REPO"
fi
# Dedicated pinned uv binary, with its publisher's release checksum.
UV="$ROOT/runtime/uv/uv"
if [ ! -x "$UV" ]; then
  fetch https://github.com/astral-sh/uv/releases/download/0.8.22/uv-aarch64-apple-darwin.tar.gz "$TMP/uv.tar.gz"
  [ "$(shasum -a 256 "$TMP/uv.tar.gz" | awk '{print $1}')" = 3f61099e261e449527141dbf125629fab33ad696468c8c90cebbac40185a306c ] || fail 'Python installer checksum mismatch. Nothing executed.'
  mkdir -p "$ROOT/runtime/uv"
  tar -xzf "$TMP/uv.tar.gz" -C "$ROOT/runtime/uv" --strip-components=1
fi
export UV_PYTHON_INSTALL_DIR="$ROOT/runtime/python" UV_PYTHON_BIN_DIR="$ROOT/runtime/bin" UV_CACHE_DIR="$ROOT/runtime/cache"
say 'Preparing private Python 3.12. Nothing changes the Mac system Python.'
"$UV" python install 3.12.11
PYTHON=$("$UV" python find --managed-python 3.12.11)
ARGS=(--role "$ROLE" --repo "$REPO" --use-existing --python "$PYTHON")
ARGS+=(--port "$PORT" --name "$NAME")
[ "$START" = 1 ] || ARGS+=(--no-start)
bash "$REPO/scripts/install.sh" "${ARGS[@]}"
say 'Next time: ~/.caravan/bin/caravan status (or doctor, start, stop, update, uninstall, add-mini).'
if [ "$START" = 1 ]; then
  READY=0
  for attempt in {1..30}; do
    if curl -fsS --max-time 2 "http://127.0.0.1:$PORT/" >/dev/null; then READY=1; break; fi
    sleep 1
  done
  if [ "$READY" = 1 ]; then
    HANDOFF=$("$HOME/.caravan/venvs/mlx/bin/python" "$REPO/tools/caravan_pairing.py" launch-file --port "$PORT" --home-page)
    open "$HANDOFF"
  else say 'The web page is not ready yet. Run ~/.caravan/bin/caravan doctor and check ~/.caravan/logs/web.log.'; exit 1; fi
fi

}
main "$@"
